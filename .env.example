# Copy this file to .env and fill in real values. Never commit .env.

# Flask session signing key. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Database. Default is a local SQLite file if left unset.
DATABASE_URL=sqlite:///healthbot.db

# Google OAuth credentials (from Google Cloud Console).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Google Gemini API key (from Google AI Studio).
GEMINI_API_KEY=

# Set to 1 ONLY for local OAuth testing over http. Leave blank in production.
OAUTHLIB_INSECURE_TRANSPORT=
